<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>Booking Update</title>
</head>

<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #222; background: #f7f7f2; padding: 24px;">
    <div
        style="max-width: 640px; margin: 0 auto; background: #ffffff; border-radius: 16px; padding: 28px; border: 1px solid #e8e5dc;">
        <p
            style="margin: 0 0 12px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #7a6b4f;">
            Cuddlemind Booking Update</p>
        <h2 style="margin: 0 0 16px; color: #1f3a35;">Booking {{statusLabel}}</h2>

        <p>Hi Dr. {{doctorName}},</p>

        {{#if isPending}}
        <p>A new booking has been assigned with {{patientName}}.</p>
        {{else if isConfirmed}}
        <p>Your booking with {{patientName}} has been confirmed.</p>
        {{else}}
        <p>Your booking with {{patientName}} has been cancelled.</p>
        {{/if}}

        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <tr>
                <td style="padding: 10px 0; color: #6b7280; width: 40%;">Patient</td>
                <td style="padding: 10px 0; font-weight: bold;">{{patientName}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #6b7280;">Session Type</td>
                <td style="padding: 10px 0; font-weight: bold; text-transform: capitalize;">{{sessionType}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #6b7280;">Scheduled At</td>
                <td style="padding: 10px 0; font-weight: bold;">{{scheduledAt}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #6b7280;">Duration</td>
                <td style="padding: 10px 0; font-weight: bold;">{{durationMinutes}} minutes</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #6b7280;">Amount</td>
                <td style="padding: 10px 0; font-weight: bold;">INR {{amount}}</td>
            </tr>
        </table>

        <p style="margin-top: 24px; color: #4b5563;">Booking status: <strong>{{statusLabel}}</strong></p>

        <p style="margin-top: 28px; color: #6b7280;">This message was generated automatically by Cuddlemind.</p>
    </div>
</body>

</html>