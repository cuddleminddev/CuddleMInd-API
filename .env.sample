# CuddleMind - .env.sample
# Copy to `.env` and fill real secrets before running in non-development environments

# General
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database (Prisma)
# Example (MySQL): mysql://user:password@host:3306/database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# Razorpay (used for payments/webhooks)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_WEBHOOK_SECRET=whsec_xxx

# Mail / SMTP (mailer module supports SMTP_* or MAIL_* env names)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Optional aliases used by code
MAIL_HOST=${SMTP_HOST}
MAIL_PORT=${SMTP_PORT}
MAIL_SECURE=${SMTP_SECURE}
MAIL_USER=${SMTP_USER}
MAIL_PASS=${SMTP_PASS}
MAIL_FROM_NAME="CuddleMind"
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM="\"CuddleMind\" <no-reply@example.com>"

# AWS S3 (uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=your-bucket-name

# Firebase (used for FCM push notifications)
# The app expects a single-line JSON string for the service account. Keep the entire JSON on one line or escape newlines.
# Example: FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}'
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"PROJECT_ID","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@PROJECT_ID.iam.gserviceaccount.com"}'

# Development/testing helpers
# If set, allows bypassing OTP checks during testing. Remove in production!
DEFAULT_OTP=123456

# Add other secrets below as needed

# NOTES:
# - Never commit your real `.env` with secrets to source control.
# - Consider using a secrets manager (Vault, AWS Secrets Manager) in production.
